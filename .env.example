# Path to the dashboard config, resolved from the working directory of the server.
# DASHBOARD_CONFIG=config.json

# Set this and /admin becomes a config editor, guarded by this one shared secret.
# Unset, the whole admin area returns 404. Generate one with:
#   openssl rand -hex 32
DASHBOARD_ADMIN_TOKEN=

DASHBOARD_SECRET_ADGUARD_MAIN=admin:your-password